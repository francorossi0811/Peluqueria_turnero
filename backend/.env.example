# Cadena de conexión a Postgres (Neon o Supabase). Ver Docs/arquitectura.md.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?schema=public"

# Secreto para firmar los JWT del panel de admin (HU-15). Generar uno propio, no reusar este.
# Obligatorio: si falta, el backend no arranca (ver src/config/env.ts) — sin esto los
# tokens se firmarían con la cadena vacía como secreto.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# --- Cuentas del panel (HU-15, HU-26) ---
# Se usan solo al correr `npx prisma db seed`, para crear las cuentas la primera vez.
# Después el seed no las vuelve a leer: las contraseñas se cambian desde el panel (HU-16)
# y viven hasheadas en la tabla `administradores`.
# OJO: este archivo se versiona en git. Las contraseñas reales van en `.env`, nunca acá.

# Ariel: rol `admin`. Puede todo lo de su peluquería, menos administrar cuentas.
#
# ⚠️ ADMIN_EMAIL es con lo que ENTRA al panel — desde HU-26 el login es por email, no por
# usuario. `ADMIN_USUARIO` quedó solo como el nombre que se muestra. Si la cuenta ya
# existía sin email, el seed se lo carga sin tocarle la contraseña; sin esta variable esa
# cuenta no puede loguearse y el seed lo avisa con un warning.
ADMIN_USUARIO="ariel"
ADMIN_EMAIL="mail-de-ariel@ejemplo.com"
ADMIN_PASSWORD="elegi-una-contrasena-propia-de-8-o-mas"

# Franco: rol `super_admin`. Lo mismo que el admin, más administrar cuentas (ver quiénes
# hay, crear una, y resetearle la contraseña a otro). Las tres variables van juntas: si
# falta alguna, la cuenta no se crea.
SUPER_ADMIN_USUARIO="franco"
SUPER_ADMIN_EMAIL="mail-de-franco@ejemplo.com"
SUPER_ADMIN_PASSWORD="elegi-una-contrasena-propia-de-8-o-mas"

PORT=3000

# URL pública del frontend. La usa el backend para armar el link de gestión del turno
# que va en el mail de confirmación (HU-19) — desde el server no existe
# `window.location.origin`. Sin barra final.
FRONTEND_URL="http://localhost:5173"

# --- Notificaciones a Ariel de turnos nuevos (HU-18, Web Push) ---
# Generar el par con `npx web-push generate-vapid-keys`. Las tres van juntas: si falta
# alguna, el push queda desactivado y el resto de la app sigue funcionando igual (el
# aviso en vivo dentro del panel, HU-17, no depende de esto).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-mail@ejemplo.com"

# --- Mail de confirmación al cliente (HU-19) ---
# Sin BREVO_API_KEY el mail no se envía de verdad: se imprime en la consola del server
# (ver src/services/mail/). Así el entorno local funciona sin necesidad de crear cuenta.
# Para enviar en serio: crear cuenta gratuita en brevo.com, validar el remitente y
# pegar la API key acá.
# OJO: este archivo se versiona en git. La key real va en `.env`, nunca acá.
BREVO_API_KEY=""
MAIL_FROM="turnos@peluqueriaariel.com"
MAIL_FROM_NOMBRE="La Peluquería de Ariel Enrique"
# A dónde responden los clientes si contestan el mail (el mail de Ariel).
MAIL_REPLY_TO=""

# --- Confirmación por WhatsApp al cliente (HU-22, Cloud API de Meta) ---
# Es el canal principal desde la v3; el mail de arriba quedó como respaldo.
#
# Sin WHATSAPP_TOKEN el mensaje no se envía de verdad: se imprime en la consola del
# server (ver src/services/whatsapp/) Y ADEMÁS sale el mail, para que desplegar esto sin
# credenciales no deje al cliente sin confirmación.
#
# Las dos primeras van juntas: si está solo una, el backend no arranca (es casi siempre
# un error de deploy, no una decisión).
#
# Para enviar en serio hacen falta: cuenta de Meta Business con una WhatsApp Business
# Account, Coexistence activado sobre el número de Ariel (lo hace él desde su celular), y
# las tres plantillas de abajo aprobadas por Meta con categoría "utility". Las dos
# primeras llevan un botón de URL dinámica `https://<dominio>/turno/{{1}}`; la de
# cancelación, un botón de URL estática al inicio del sitio (el turno cancelado ya no se
# gestiona, así que no tiene link propio). Los textos están en Docs/plantillas-whatsapp.md.
#
# OJO: este archivo se versiona en git. El token real va en `.env`, nunca acá.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# El secreto del handshake del webhook. ⚠️ NO lo da Meta: lo inventás vos (cualquier
# string largo) y lo pegás igual en Meta → WhatsApp → Configurar webhooks → "Token de
# verificación". Meta lo manda de vuelta una sola vez, al dar de alta la suscripción, y
# el endpoint lo compara para saber que la llamada es legítima.
#
# Si falta, GET /api/webhooks/whatsapp responde 403 siempre y el alta no se puede hacer.
# El backend arranca igual: no expone el webhook, y eso es un estado válido.
WHATSAPP_VERIFY_TOKEN=""
# Opcionales: los defaults son los nombres que usamos de verdad.
# ⚠️ `_v2` no es un typo: ver Docs/plantillas-whatsapp.md.
WHATSAPP_PLANTILLA_CONFIRMADO="turno_confirmado_v2"
WHATSAPP_PLANTILLA_REPROGRAMADO="turno_reprogramado"
# Son dos: el mensaje al que canceló con tiempo agradece, y el del turno que dio de baja
# Ariel pide disculpas. Ver Docs/plantillas-whatsapp.md.
WHATSAPP_PLANTILLA_CANCELADO_CLIENTE="turno_cancelado_cliente"
WHATSAPP_PLANTILLA_CANCELADO_NEGOCIO="turno_cancelado_negocio"
# ⚠️ Solo mientras se use el NÚMERO DE PRUEBA de Meta: su lista de destinatarios
# autorizados guarda los números sin el 9 de celular y compara literal. Con el
# número real esto va en "false" o directamente afuera.
WHATSAPP_NUMERO_DE_PRUEBA="false"
WHATSAPP_IDIOMA="es_AR"
WHATSAPP_API_VERSION="v23.0"
