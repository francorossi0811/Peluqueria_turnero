// Traducción 1:1 de Docs/modelo-datos.md — no agregar reglas de negocio nuevas acá,
// cualquier cambio de modelo pasa primero por ese documento.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoTurno {
  reservado
  cancelado
  reprogramado
  realizado
  ausente
}

// Por dónde entró la reserva. `presencial` es el cliente de vidriera que Ariel atiende y
// registra después (HU-08): no llamó ni escribió, así que meterlo en `llamada` sería un
// dato falso. `llamada` se llamaba `telefono` y se renombró porque se confundía con
// `cliente_telefono`, que es un dato de contacto y no un canal.
enum OrigenTurno {
  online
  presencial
  llamada
  whatsapp
}

// Qué hace Ariel en un feriado. Reemplaza al `bloquea` booleano, que solo sabía decir
// "atiende" o "no atiende": la regla real tiene tres estados y el default no es cerrar.
enum ModalidadFeriado {
  cerrado
  medio_dia
  dia_completo
}

// HU-27 — Cómo le pagó el cliente ese turno.
//
// Enum y no una tabla configurable, al revés que `etiquetas`: allá el texto que escribe
// Ariel *es* el contenido, acá el conjunto es cerrado y estable, y el desglose por medio
// necesita categorías fijas para poder sumarse. Una tabla para cuatro valores que no
// cambian sería generalidad especulativa; si algún día aparece otro medio, agregarlo es
// una migración de una línea.
enum MedioPago {
  efectivo
  transferencia
  mercado_pago
  tarjeta
}

model Servicio {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  duracionMinutos Int      @map("duracion_minutos")
  activo          Boolean  @default(true)
  /// Posición en la que se le muestran al cliente, del más pedido al menos. Es un dato
  /// propio y no derivable: el orden que quiere Ariel no coincide ni con el alfabético
  /// ni con la duración. Menor va primero; a igual valor desempata el nombre.
  orden           Int      @default(0)

  /// HU-27 — Cuánto sale, en pesos enteros. Es un dato **interno**: Ariel lo carga y lo
  /// ve en su panel, y el cliente no lo ve en ningún momento (el endpoint público mapea
  /// campo por campo, ver `getServiciosPublico`).
  ///
  /// Entero y no decimal porque Ariel no cobra centavos, y así no hay redondeo de punto
  /// flotante en ninguna suma. Nullable porque `null` es un estado real —"todavía no le
  /// puse precio"—: un `0` por default sería un dato falso, y el modal de cobro lo
  /// mostraría como si fuera el precio.
  precio          Int?

  /// La foto que ve el cliente en la landing. Ruta pública dentro de `frontend/public`
  /// (`/imagenes/servicio-corte.jpg`); `null` = cae a una foto de stock.
  ///
  /// ⚠️ Vive acá y no en un mapa `nombre → foto` en el frontend, que es como estaba: el
  /// nombre del servicio lo edita Ariel desde el panel (HU-13), así que renombrar
  /// "Corte clásico" le borraba la foto en silencio y nada lo avisaba. Atada a la fila,
  /// el nombre puede cambiar todas las veces que quiera.
  ///
  /// Al revés que `precio`, esta columna **sí** sale por la API pública: es justamente
  /// lo que se dibuja del lado del cliente.
  foto            String?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  turnos Turno[]

  /// HU-29 — La foto que sube Ariel desde el panel, si la subió. **Gana sobre `foto`**, que
  /// quedó para las rutas estáticas de los 4 servicios originales: esas las sirve el CDN de
  /// Vercel, que es mejor que servirlas desde Render, así que no se migran.
  ///
  /// Es una relación y no una copia de la URL en `foto` a propósito: escribir la URL ahí
  /// serían dos escrituras que pueden divergir, y una fila borrada dejaría el string
  /// apuntando a una imagen que ya no existe.
  imagen Imagen?

  @@map("servicios")
}

// Una fila por franja horaria (ej. martes tiene 2: mañana y tarde). Sin filas = cerrado.
model HorarioLaboral {
  id         Int      @id @default(autoincrement())
  diaSemana  Int      @map("dia_semana") // 0=domingo … 6=sábado
  horaInicio DateTime @map("hora_inicio") @db.Time()
  horaFin    DateTime @map("hora_fin") @db.Time()

  @@map("horario_laboral")
}

// Cubre tanto una franja puntual (una tarde) como un rango de varios días (vacaciones).
model BloqueoHorario {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fechaInicio DateTime  @map("fecha_inicio") @db.Date
  horaInicio  DateTime? @map("hora_inicio") @db.Time() // null = desde el inicio del horario laboral
  fechaFin    DateTime  @map("fecha_fin") @db.Date
  horaFin     DateTime? @map("hora_fin") @db.Time() // null = hasta el cierre del horario laboral
  motivo      String?
  createdAt   DateTime  @default(now()) @map("created_at")

  turnosCancelados Turno[]

  @@map("bloqueos_horario")
}

model Feriado {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @unique @db.Date
  nombre    String?
  fuente    String? // de dónde se importó
  // En un feriado Ariel trabaja medio día por defecto (la primera franja del día), y
  // decide si lo cambia. Por eso el default no es `cerrado`: cerrar sería inventarle una
  // decisión que no tomó. Solo tiene efecto en los días que trabaja — un feriado que cae
  // domingo o lunes no cambia nada, porque `horario_laboral` no tiene franjas ahí.
  modalidad ModalidadFeriado @default(medio_dia)
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("feriados")
}

// HU-25 — La ficha del cliente. La identidad es el **teléfono normalizado**, no el
// nombre: dos reservas con el mismo número son la misma persona, y el nombre que tipea
// el cliente cambia de una vez a la otra ("Juan", "juan perez", "Juan P.").
//
// El turno sigue guardando `clienteNombre`/`clienteTelefono` tal como se escribieron
// (ver más abajo). Esta tabla no los reemplaza: es la identidad estable a la que se
// enganchan, y `Turno.clienteId` es el vínculo. Por eso corregir un teléfono mal tipeado
// no despega el historial de la ficha.
model Cliente {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // E.164 sin el `+` (`5493514593325`), tal como lo devuelve `utils/telefono.ts`. Único:
  // es lo que hace que la ficha se encuentre sola en la segunda reserva, sin que Ariel
  // tenga que unir nada a mano.
  telefonoE164 String @unique @map("telefono_e164")

  /// El nombre que Ariel le pone: en su planilla usa "Flaco", "Jubilado bici", "Roja".
  /// Null hasta que se lo pone; ahí manda sobre `nombre` en toda la interfaz.
  apodo String?

  /// Cómo se presentó la última vez que reservó. Se pisa en cada turno nuevo a propósito:
  /// es el nombre con el que el cliente se identifica hoy, no un histórico.
  nombre String

  /// Observaciones de Ariel sobre esa persona ("le gusta el degradé bajo", "viene con el
  /// nene"). Es lo que hace que esto sea una ficha y no un contador de visitas.
  notas String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  turnos    Turno[]
  etiquetas ClienteEtiqueta[]
  fotos     Imagen[]

  @@map("clientes")
}

/// HU-29 — Las fotos que sube Ariel: la galería de una ficha ("así le gusta el degradé") y
/// la foto de un servicio para la landing.
///
/// ⚠️ **El archivo vive en Postgres y no en un bucket**, y conviene saber por qué. No había
/// *ningún* lugar donde un archivo subido sobreviviera: `frontend/public` se hornea en el
/// build de Vercel y el disco de Render es efímero. Un bucket significaba una cuenta nueva y
/// un trámite externo — lo mismo que tiene a WhatsApp frenado. Como el frontend solo ve la
/// URL `/api/imagenes/<id>`, mudarse a un bucket después no le toca una línea.
///
/// El techo es real: Neon free tier son 0,5 GB. Lo que hace viable la decisión son las dos
/// cosas de las que no hay que aflojar — la compresión en el navegador (~150 KB por foto) y
/// el tope de fotos por ficha.
model Imagen {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// El archivo, ya comprimido por el navegador antes de subirse.
  datos Bytes

  mimeType String @map("mime_type")

  /// El peso en bytes. Redundante con `length(datos)` a propósito: es lo que permite sumar
  /// cuánto se está ocupando sin traerse un solo blob a memoria.
  bytes Int

  /// Los dos dueños son excluyentes, y la base lo hace cumplir con un CHECK escrito a mano
  /// en la migración (`imagenes_un_solo_dueno`). Sin él la tabla admite una fila sin dueño
  /// —que nadie puede alcanzar ni borrar— y otra con dos, que no se sabe qué significa.
  clienteId String?  @db.Uuid @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Unique: "una foto por servicio" es una regla, y vive acá y no solo en el service.
  servicioId String?   @unique @db.Uuid @map("servicio_id")
  servicio   Servicio? @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  /// Orden dentro de la galería de una ficha. Sin uso para la foto de un servicio.
  orden Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clienteId, orden])
  @@map("imagenes")
}

// HU-25 — Las insignias que Ariel se arma solo. Un círculo de color con el texto que él
// le escriba ("Suele cancelar", "VIP", "Paga con Mercado Pago").
//
// Configurables y no un booleano de "problemático": la planilla usa un color para eso
// porque es lo único que Sheets permite, y no hay motivo para heredar esa limitación.
model Etiqueta {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre String @unique

  /// Identidad estable para las etiquetas que pone el sistema solo (hoy solo
  /// `cliente_nuevo`). `null` en las que crea Ariel a mano.
  ///
  /// Existe para separar **qué etiqueta es** de **cómo se llama**: Ariel puede renombrarla
  /// a "Primera vez" y cambiarle el color cuando quiera, y el automatismo la sigue
  /// encontrando. Buscarla por nombre haría que renombrarla la rompiera en silencio.
  clave String? @unique

  /// Hexadecimal `#rrggbb`. Lo elige Ariel libremente: la insignia es un círculo pleno,
  /// no texto sobre un fondo de color, así que ningún valor la vuelve ilegible (la
  /// interfaz le dibuja un anillo para que un color oscuro se recorte sobre el tema
  /// oscuro).
  color String

  createdAt DateTime @default(now()) @map("created_at")

  clientes ClienteEtiqueta[]

  @@map("etiquetas")
}

// Muchos a muchos: un cliente puede ser "VIP" y "Suele cancelar" a la vez.
model ClienteEtiqueta {
  clienteId  String @map("cliente_id") @db.Uuid
  etiquetaId String @map("etiqueta_id") @db.Uuid

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([clienteId, etiquetaId])
  @@map("cliente_etiquetas")
}

// Qué puede hacer cada cuenta del panel (HU-26).
//
// La diferencia real es chica y conviene que se note acá: todo lo que hace el panel *es*
// gestionar la peluquería, así que lo único que el `admin` no puede es administrar
// cuentas — ver quiénes hay, crear una, y resetearle la contraseña a otro. No hay una
// tercera cosa escondida.
enum RolAdmin {
  super_admin
  admin
}

model Administrador {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// El nombre que se muestra en el panel. Dejó de ser la credencial cuando el login pasó
  /// a ser por email (HU-26): son dos cosas distintas y estaban mezcladas en esta columna.
  usuario String @unique

  /// Con lo que se entra, y a dónde va el link de "me olvidé la contraseña".
  ///
  /// Nullable en el esquema y **obligatorio en la práctica**: una fila sin email no puede
  /// loguearse. Es nullable porque la columna se agregó sobre una base con una cuenta ya
  /// creada, y ponerle un email inventado para satisfacer un NOT NULL habría sido escribir
  /// un dato falso en la única fila que importaba. Lo carga el seed desde `ADMIN_EMAIL`.
  email String? @unique

  rol RolAdmin @default(admin)

  passwordHash String @map("password_hash")

  // HU-16 — Cuándo cambió la contraseña por última vez. Los tokens emitidos antes de
  // esta fecha dejan de valer (ver tokenPrecedeAlCambioDePassword en auth.service.ts),
  // que es lo que hace que cambiar la contraseña realmente cierre las otras sesiones.
  // Nullable: la cuenta creada por el seed nunca cambió la contraseña, y `null` se lee
  // natural como "no hay nada que invalidar".
  passwordChangedAt DateTime? @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("administradores")
}

// HU-18 — Suscripciones de Web Push del navegador de Ariel (una por dispositivo).
// Sin FK a `administradores` a propósito: hay un solo admin, y agregar una relación
// "por las dudas" sería generalidad especulativa. Ver Docs/modelo-datos.md.
model PushSuscripcion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // La URL que da el navegador para empujarle una notificación. Única: si el mismo
  // dispositivo se vuelve a suscribir, se actualiza en vez de duplicarse.
  endpoint String @unique
  p256dh   String
  auth     String

  // Diagnóstico. Ariel usa dos celulares y una computadora, así que "avisos activados en
  // 3 dispositivos" no dice nada útil cuando uno deja de andar: esto permite ver cuál es
  // cuál y cuándo fue la última vez que el servicio de push aceptó un envío.
  //
  // `ultimoEstado` es el código HTTP que devolvió el servicio de push (201 = aceptado).
  // Ojo: aceptado NO es entregado — el servicio lo toma y después decide si el
  // dispositivo lo recibe. Es el techo de lo que podemos saber desde el servidor.
  userAgent      String?   @map("user_agent")
  ultimoIntentoEn DateTime? @map("ultimo_intento_en")
  ultimoEstado   Int?      @map("ultimo_estado")
  ultimoError    String?   @map("ultimo_error")

  createdAt DateTime @default(now()) @map("created_at")

  // El `@default(now())` no es decorativo y no se puede sacar. La migración
  // `diagnostico_push` tuvo que escribir `DEFAULT CURRENT_TIMESTAMP` a mano, porque Prisma
  // genera `@updatedAt` sin default y agregar una columna NOT NULL sin default falla sobre
  // una tabla que ya tiene filas. Ese default quedó viviendo en la base y no en el
  // esquema, así que **cada diff posterior emitía un `DROP DEFAULT`** que había que borrar
  // a mano — pasó en `fichas_de_clientes` y volvió a pasar acá. Declararlo lo alinea y
  // corta la deriva para siempre.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("push_suscripciones")
}

model Turno {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // ^ se usa directamente como token del link único del cliente — no hay campo aparte.

  clienteNombre String @map("cliente_nombre")

  // Obligatorio cuando reserva un cliente por la web (es el único dato con el que Ariel
  // lo puede ubicar), opcional cuando el turno lo carga Ariel a mano: no se sabe los
  // teléfonos de memoria y le quedaba trabado el alta. La diferencia se hace en el
  // schema de validación de cada endpoint, no acá — ver `turnos.controller.ts`.
  clienteTelefono String? @map("cliente_telefono")

  // HU-19 — Opcional a propósito: muchos clientes de Ariel no usan mail. Los que lo
  // dejan reciben la confirmación con el link de gestión; los que no, siguen
  // arreglándose por WhatsApp con Ariel, como hasta ahora.
  clienteEmail String? @map("cliente_email")

  // HU-25 — La ficha a la que pertenece este turno. Null cuando no hay teléfono (Ariel
  // puede cargar un turno sin él, HU-08): sin número no hay identidad, y una ficha vacía
  // por cada turno suelto sería peor que no tenerla. Se completa solo en cuanto le carga
  // el teléfono.
  //
  // Los campos `clienteNombre`/`clienteTelefono` de arriba **no** se van: siguen siendo
  // la copia de lo que se escribió al reservar, igual que el snapshot del servicio.
  clienteId String?  @map("cliente_id") @db.Uuid
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  servicioId String   @map("servicio_id") @db.Uuid
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  // "Foto" del servicio al momento de reservar — independiente de `servicio` de ahí en más.
  servicioNombreSnapshot   String @map("servicio_nombre_snapshot")
  servicioDuracionSnapshot Int    @map("servicio_duracion_snapshot")

  fecha      DateTime @db.Date
  horaInicio DateTime @map("hora_inicio") @db.Time()
  horaFin    DateTime @map("hora_fin") @db.Time() // calculada; usada por el EXCLUDE constraint

  estado            EstadoTurno @default(reservado)
  origen            OrigenTurno @default(online)
  motivoCancelacion String?     @map("motivo_cancelacion")

  // HU-27 — El cobro. Columnas acá y no una tabla `pagos`: hay un pago por turno, sin
  // pagos parciales ni historial, así que una tabla aparte sería estado que se puede
  // desincronizar del turno para conseguir exactamente lo mismo. Mismo criterio con el
  // que el token de reset de HU-26 no tiene tabla.
  //
  // Los tres van juntos: o están los tres o no está ninguno. `null` en los tres significa
  // "todavía no se registró el cobro", que es un estado legítimo —Ariel puede marcar
  // Realizado y cargar el cobro después, igual que el teléfono en HU-25— y es el estado
  // en el que quedan todos los turnos anteriores a esta etapa. La pantalla de Cobros los
  // muestra aparte: un total al que le faltan turnos sin decirlo es peor que no tenerlo.
  medioPago MedioPago? @map("medio_pago")

  /// Pesos enteros. **No es un snapshot del precio al reservar**, a diferencia de
  /// `servicioDuracionSnapshot`: la duración se congela porque decide la disponibilidad y
  /// cambiarla movería turnos ya agendados, pero el precio no afecta nada hasta que se
  /// cobra. Con inflación, un turno reservado hace tres semanas se cobra al precio de
  /// hoy. Se copia del precio del servicio al momento de cobrar y Ariel lo puede pisar
  /// (descuento, jubilado, changa), que es la otra mitad de por qué se guarda el monto y
  /// no una referencia al servicio.
  montoCobrado Int? @map("monto_cobrado")

  cobradoEn DateTime? @map("cobrado_en")

  // HU-17 — Si Ariel ya vio este turno en el panel. Los que carga él mismo nacen en
  // `true` (no tiene sentido avisarle de lo que acaba de tipear). Vive en la base y no
  // en el navegador porque Ariel usa el celular y la tablet del mostrador: marcarlo como
  // visto en uno tiene que callarlo en el otro.
  vistoPorAdmin Boolean @default(false) @map("visto_por_admin")

  turnoOrigenId String? @map("turno_origen_id") @db.Uuid
  turnoOrigen   Turno?  @relation("Reprogramacion", fields: [turnoOrigenId], references: [id])
  turnosNuevos  Turno[] @relation("Reprogramacion")

  bloqueoCancelacionId String?         @map("bloqueo_cancelacion_id") @db.Uuid
  bloqueoCancelacion   BloqueoHorario? @relation(fields: [bloqueoCancelacionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fecha, horaInicio])
  @@index([estado])
  @@map("turnos")
}

// NOTA — pendiente de agregar a mano después del primer `prisma migrate dev --create-only`:
// EXCLUDE USING gist (tsrange(fecha + hora_inicio, fecha + hora_fin) WITH &&)
// WHERE (estado = 'reservado')
// Prisma no puede expresar un EXCLUDE constraint en el schema; ver Docs/modelo-datos.md
// sección "Reglas de integridad clave" y el plan de esta etapa.

/// El estado de una de las dos llamadas de sincronización de Coexistence.
///
/// `en_curso` no es cosmético: la fila se inserta **antes** de llamar a Meta, así que ese
/// es el estado real mientras la llamada está en vuelo, y también el que queda pegado si
/// el proceso se cae en el medio. Ver el modelo de abajo.
enum EstadoSincronizacion {
  en_curso
  ok
  error
}

/// Las dos llamadas de sincronización de Coexistence (SMB App Data API), una fila cada una.
///
/// ⚠️ **Cada llamada se puede ejecutar UNA sola vez en la vida del número.** Si se repite o
/// falla, Meta obliga al negocio a desvincularse y rehacer el Embedded Signup entero. De
/// ahí sale todo el diseño de esta tabla:
///
/// - `syncType` es **`@unique`**, y esa es la garantía real de "una sola vez". Un chequeo
///   en la aplicación lo pasarían dos requests simultáneos y las dos ejecutarían — la misma
///   razón por la que la doble reserva se previene con un constraint y no con un `if`.
/// - La fila se inserta **antes** de llamar a Meta. Al revés, una caída entre la llamada y
///   el `INSERT` dejaría la llamada hecha y sin registro, y el próximo intento la
///   repetiría: el único desenlace que no tiene arreglo. Insertando primero, el peor caso
///   es una fila marcada como usada sin `requestId`, que se resuelve hablando con soporte.
///
/// Consecuencia asumida: **una llamada fallida bloquea el reintento igual**. Destrabarla es
/// borrar la fila a mano, y el 409 del segundo intento lo dice con todas las letras.
model CoexistenceSincronizacion {
  id String @id @default(uuid()) @db.Uuid

  /// `smb_app_state_sync` o `history`, tal cual los nombra Meta. Es el valor que viaja en
  /// el cuerpo del POST, así que se guarda igual y no traducido.
  syncType String @unique @map("sync_type")

  estado EstadoSincronizacion @default(en_curso)

  /// Lo que devuelve Meta y hay que darle a soporte si algo sale mal. Es la única razón
  /// por la que esta tabla guarda algo además del "ya se corrió".
  requestId String? @map("request_id")

  /// La respuesta completa, como vino. Sin parsear: si algo falla, lo que sirve es el
  /// cuerpo crudo y no nuestra interpretación de él.
  respuesta String?

  iniciadoEn  DateTime  @default(now()) @map("iniciado_en")
  terminadoEn DateTime? @map("terminado_en")

  @@map("coexistence_sincronizaciones")
}
